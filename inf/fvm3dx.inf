; XPDM display driver for QEMU's standard VGA (PCI 1234:1111), announcing the
; fvm3dx OpenGL ICD.
;
; The miniport talks the Bochs VBE registers 0x1CE/0x1CF, the display driver adds
; DrvEscape/OPENGL_GETINFO so that opengl32.dll finds fvm3dx32.dll.

[Version]
Signature   = "$Windows NT$"
Class       = Display
ClassGUID   = {4D36E968-E325-11CE-BFC1-08002BE10318}
Provider    = %Provider%
DriverVer   = 09/02/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir  = 11
Fvm3dx.Miniport = 12
Fvm3dx.Display  = 11

[Manufacturer]
%Provider% = Fvm3dx

[Fvm3dx]
%Fvm3dx.DeviceDesc% = Fvm3dx_Install, PCI\VEN_1234&DEV_1111

[Fvm3dx_Install]
CopyFiles = Fvm3dx.Miniport, Fvm3dx.Display
AddReg    = Fvm3dx_OpenGL_AddReg

[Fvm3dx.Miniport]
qemump.sys

[Fvm3dx.Display]
qemudisp.dll

[Fvm3dx_Install.Services]
AddService = qemump, 0x00000002, Fvm3dx_Service

[Fvm3dx_Service]
ServiceType    = 1              ; SERVICE_KERNEL_DRIVER
StartType      = 1              ; SERVICE_SYSTEM_START
ErrorControl   = 0              ; SERVICE_ERROR_IGNORE
LoadOrderGroup = Video
ServiceBinary  = %12%\qemump.sys

[Fvm3dx_Install.SoftwareSettings]
AddReg = Fvm3dx_SoftwareDeviceSettings

[Fvm3dx_SoftwareDeviceSettings]
HKR,, InstalledDisplayDrivers, %REG_MULTI_SZ%, qemudisp
HKR,, VgaCompatible,           %REG_DWORD%,    0
HKR,, Acceleration.Level,      %REG_DWORD%,    0

; The mode Windows starts in when nothing is stored yet. Without it a fresh XP came up at 2560x1440, the preferred mode of the EDID, a window larger than a 1440p desktop.
; Once a resolution is chosen Windows keeps that one, so this only shapes a first installation.
HKR,, DefaultSettings.XResolution, %REG_DWORD%, 1024
HKR,, DefaultSettings.YResolution, %REG_DWORD%, 768
HKR,, DefaultSettings.BitsPerPel,  %REG_DWORD%, 32

; The escape hands out the key name, opengl32.dll looks the library up here. Under NT that
; name is a *subkey* with four values, not a plain REG_SZ value like on Windows 9x -- read
; out of XPs own opengl32.dll, see docs/LOG.md [427] and [432].
;
; Flags bit 0 -- without it opengl32.dll loads the ICD, accepts it and then never asks it for
;   a pixel format, so every application ends up on the generic software formats and renders
;   in software.
; Flags bit 1 -- without it opengl32.dll calls glFinish() before every single SwapBuffers
;   (__DrvSwapBuffers checks the bit). Across the device boundary that is a full round trip
;   that waits for the GPU, and it costs a third of the frame rate: 7497 instead of 11415 FPS.
;
; Version and DriverVersion have to repeat what the OPENGL_GETINFO escape hands out
; (display/icd.c) -- opengl32.dll compares the two and drops the driver when they differ.
; The 9x style value stays next to it; Windows 9x reads only that one and ignores the rest.
[Fvm3dx_OpenGL_AddReg]
HKLM,"Software\Microsoft\Windows\CurrentVersion\OpenGLdrivers",          "FVM3DX",        0x00000000, "fvm3dx32.dll"
HKLM,"Software\Microsoft\Windows NT\CurrentVersion\OpenGLdrivers\FVM3DX","DLL",           0x00000000, "fvm3dx32.dll"
HKLM,"Software\Microsoft\Windows NT\CurrentVersion\OpenGLdrivers\FVM3DX","Flags",         0x00010001, 3
HKLM,"Software\Microsoft\Windows NT\CurrentVersion\OpenGLdrivers\FVM3DX","Version",       0x00010001, 2
HKLM,"Software\Microsoft\Windows NT\CurrentVersion\OpenGLdrivers\FVM3DX","DriverVersion", 0x00010001, 1

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
qemump.sys   = 1
qemudisp.dll = 1

[Strings]
REG_SZ       = 0x00000000
REG_MULTI_SZ = 0x00010000
REG_DWORD    = 0x00010001

Provider           = "fvm3dx"
DiskName           = "fvm3dx display driver disk"
Fvm3dx.DeviceDesc  = "QEMU Standard VGA (fvm3dx ICD)"
